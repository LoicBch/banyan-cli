{
  "name": "banyan-cli",
  "version": "1.0.0",
  "description": "tmux + git worktrees + Claude Code. Run N AI agents in parallel across N repos with isolated worktrees, dev ports, and docker stacks per feature.",
  "type": "module",
  "bin": {
    "banyan": "dist/src/bin/banyan.js",
    "bn": "dist/src/bin/banyan.js"
  },
  "files": [
    "dist/src",
    "dist/tmux",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoicBch/banyan-cli.git"
  },
  "bugs": {
    "url": "https://github.com/LoicBch/banyan-cli/issues"
  },
  "homepage": "https://banyan.sh",
  "license": "MIT",
  "author": "Loïc Bouchisse",
  "keywords": [
    "tmux",
    "git-worktree",
    "claude-code",
    "mcp",
    "monorepo",
    "multi-repo",
    "developer-tools",
    "cli",
    "workflow"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ts && npm run build:web && npm run build:assets",
    "build:ts": "tsc -p tsconfig.json",
    "build:web": "vite build --config src/dashboard/web/vite.config.ts",
    "build:assets": "mkdir -p dist/src/dashboard dist/tmux && cp -R src/dashboard/static dist/src/dashboard/ && cp -R tmux/. dist/tmux/ && chmod +x dist/src/bin/banyan.js",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:web": "vite --config src/dashboard/web/vite.config.ts",
    "test": "node --test 'dist/test/**/*.test.js'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "@xhayper/discord-rpc": "^1.3.4",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.0",
    "vite": "^6.0.7"
  }
}
